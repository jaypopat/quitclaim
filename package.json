{
  "name": "quitclaim",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @quitclaim/web dev",
    "typecheck": "bun check",
    "test": "bun test packages apps",
    "build:lot": "cd contracts/lot && cargo near build non-reproducible-wasm",
    "test:lot": "cargo test -p quitclaim-lot",
    "test:sandbox": "bun run build:lot && cargo near build non-reproducible-wasm --manifest-path tests/mpc-fixture/Cargo.toml && cargo test -p quitclaim-sandbox -- --nocapture",
    "build:release": "cargo near build reproducible-wasm --manifest-path contracts/lot/Cargo.toml",
    "build:evm": "cd contracts/evm && forge build",
    "test:evm": "cd contracts/evm && forge test",
    "verify": "bun run abi --check && bun run typecheck && bun run test && bun run test:lot && bun run test:sandbox && bun run build:evm && bun run test:evm",
    "deploy-lot": "bun packages/ops/src/deploy-lot.ts",
    "lot-address": "bun packages/ops/src/lot-address.ts",
    "abi": "bun packages/shared/scripts/gen-abi.ts",
    "e2e": "bun packages/ops/src/e2e/index.ts",
    "heist": "bun --no-env-file packages/ops/src/heist.ts",
    "test:heist": "bun --no-env-file packages/ops/src/heist-live.ts",
    "keeper": "bun packages/ops/src/keeper.ts",
    "freeze": "bun packages/ops/src/freeze.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
