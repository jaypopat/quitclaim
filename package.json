{
  "name": "quitclaim",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter @quitclaim/web dev",
    "typecheck": "bun check",
    "test": "bun test packages apps",
    "build:lot": "cd contracts/lot && cargo near build non-reproducible-wasm",
    "test:lot": "cargo test -p quitclaim-lot",
    "build:vesting": "cd contracts/vesting && forge build",
    "test:vesting": "cd contracts/vesting && forge test",
    "verify": "bun run typecheck && bun run test && bun run test:lot && bun run build:lot && bun run build:vesting && bun run test:vesting"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
