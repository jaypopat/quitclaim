{
  "name": "quitclaim",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "fmt": "bun fmt --no-script && cargo fmt --all",
    "fmt:check": "bun fmt --no-script --check && cargo fmt --all --check",
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bun --filter @quitclaim/web dev",
    "typecheck": "bun check -b",
    "test": "bun test packages apps",
    "build:lot": "cd contracts/lot && cargo near build non-reproducible-wasm",
    "test:lot": "cargo test -p quitclaim-lot",
    "test:sandbox": "bun run build:lot && cargo near build non-reproducible-wasm --manifest-path tests/mpc-fixture/Cargo.toml && cargo test -p quitclaim-sandbox -- --nocapture",
    "build:release": "cargo near build reproducible-wasm --manifest-path contracts/lot/Cargo.toml",
    "verify": "bun run abi --check && bun run typecheck && bun run test && bun run test:lot && bun run test:sandbox",
    "deploy-lot": "bun apps/cli/src/deploy-lot.ts",
    "lot-address": "bun apps/cli/src/lot-address.ts",
    "abi": "bun packages/shared/scripts/gen-abi.ts",
    "e2e": "bun apps/cli/src/e2e/index.ts",
    "heist": "bun --no-env-file apps/cli/src/heist.ts",
    "test:heist": "bun --no-env-file apps/cli/src/heist-live.ts",
    "keeper": "bun apps/keeper/src/keeper.ts",
    "cash-out": "bun apps/cli/src/cash-out.ts",
    "seed": "bun apps/cli/src/seed.ts",
    "freeze": "bun apps/cli/src/freeze.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
