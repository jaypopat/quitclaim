# Copy to .env (gitignored). Bun loads it when commands run from the repo root.
PORT=3000                            # web port in development and inside the container; no host port is published
FUNDER_PK=0x...                       # Base Sepolia key that pays vesting deploys and lot gas
LOT_CONTRACT=quitclaim.testnet
VITE_LOT_CONTRACT=$LOT_CONTRACT   # the web app's copy; Vite inlines VITE_* into the browser bundle
DEPLOYER_ACCOUNT=quitclaim-spike-43135.testnet   # parent account for deploy-lot; no power over deployed contracts
ALICE_ACCOUNT=quitclaim-spike-43135.testnet
BOB_ACCOUNT=bob.quitclaim-spike-43135.testnet
CAROL_ACCOUNT=carol.quitclaim-spike-43135.testnet
MINTER_ACCOUNT=quitclaim-faucet-47905.testnet   # NEAR mint caller; receives the royalty on lot sales
KEEPER_ACCOUNT=bob.quitclaim-spike-43135.testnet   # proves, rebumps and rescues for the keeper and e2e; any funded account works
