DEPLOYER_ACCOUNT=quitclaim-spike-43135.testnet   # parent account for deploy-lot; no power over deployed contracts
ALICE_ACCOUNT=quitclaim-spike-43135.testnet
BOB_ACCOUNT=bob.quitclaim-spike-43135.testnet
CAROL_ACCOUNT=carol.quitclaim-spike-43135.testnet
